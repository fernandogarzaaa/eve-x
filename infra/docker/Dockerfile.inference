# EVE-X inference image (stdlib-only server; torch optional for model load).
# Fail-closed default: no weights + no --allow-heuristic -> /ready 503,
# /infer 503. Production mounts weights + expected sha256 (see
# ml/inference/server.py flags); dev compose opts into --allow-heuristic
# explicitly (always degraded=true, never a trained model).
# Build from the repo root: docker build -f infra/docker/Dockerfile.inference .
FROM python:3.11-slim@sha256:bab1b7ef4b450c81002278d035eff85ebe394ae94df904f7a3ba14f7e16e487b AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    INFERENCE_PORT=8090
WORKDIR /app
COPY ml ./ml
RUN useradd --system --create-home --home-dir /home/evex evex \
  && chown -R evex:evex /app
EXPOSE 8090
USER evex
HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8090/health').status==200 else 1)"
CMD ["python", "ml/inference/server.py", "--host", "0.0.0.0", "--port", "8090", "--cpu"]
