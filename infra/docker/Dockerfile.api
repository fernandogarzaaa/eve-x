# EVE-X control-plane API image.
# Build from the repo root: docker build -f infra/docker/Dockerfile.api .
# Base pinned by digest (release reproducibility §9); refresh deliberately.
FROM node:25-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS base
ENV NODE_ENV=production \
    PORT=8080 \
    DATA_DIR=/data \
    OBJECT_DIR=/data/objects
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund \
  && npm cache clean --force
# dist is the single source of truth (built by `npm run build` from the
# release commit); never COPY source trees into the image.
COPY dist ./dist
RUN useradd --system --create-home --home-dir /home/evex evex \
  && mkdir -p /data /data/objects \
  && chown -R evex:evex /app /data
VOLUME ["/data"]
EXPOSE 8080
USER evex
HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD node -e "fetch('http://localhost:8080/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "dist/apps/api/src/index.js"]
