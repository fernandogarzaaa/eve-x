{
  "name": "eve-x",
  "version": "1.0.3",
  "description": "EVE-X: isolated-VM computer-use experience validation platform",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "gen:identity": "node scripts/gen-release-identity.mjs",
    "clean": "node scripts/clean.mjs",
    "prebuild": "node scripts/gen-release-identity.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "typecheck": "node scripts/gen-release-identity.mjs && tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "pretest": "node scripts/gen-release-identity.mjs && tsc -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "test:all": "node scripts/run-tests.mjs",
    "doctor": "node dist/apps/cli/src/index.js doctor",
    "server": "node dist/apps/api/src/index.js",
    "worker": "node dist/apps/worker/src/index.js",
    "mcp": "node dist/apps/mcp/src/index.js",
    "cli": "node dist/apps/cli/src/index.js",
    "benchmark": "node dist/apps/cli/src/index.js benchmark run",
    "security:audit": "node scripts/security-audit.mjs",
    "package": "node scripts/package-release.mjs",
    "release": "node scripts/gen-release-manifest.mjs && node scripts/gen-provenance.mjs && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "express": "^5.2.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0"
  },
  "bin": {
    "eve-x": "dist/apps/cli/src/index.js"
  }
}
