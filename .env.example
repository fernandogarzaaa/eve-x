PORT=8080
WS_PORT=8081
VNC_PORT=5900
DATA_DIR=./data
OBJECT_DIR=./data/objects
DATABASE_URL=postgres://evex:evex@localhost:5432/evex
REDIS_URL=redis://localhost:6379
# S3-compatible object storage (Garage v2). Secrets are injected at deploy
# time (see infra/deployment/object-storage/bring-up.sh) and must never be
# committed here.
OBJECT_ENDPOINT=http://localhost:3900
GARAGE_BUCKET=evex
# GARAGE_RPC_SECRET=<64-hex generated at deploy time>
# GARAGE_ADMIN_TOKEN=<64-hex generated at deploy time>
# GARAGE_S3_KEY=<issued by garage key create>
# GARAGE_S3_SECRET=<issued by garage key create>
INFERENCE_URL=http://localhost:8090
EVEX_AUTH_TOKEN=change-me
VM_BACKEND=auto
QEMU_BIN=qemu-system-x86_64
# Pinned golden base image filename inside EVEX_IMAGES (overlays boot from it)
# EVEX_BASE_IMAGE=eve-desktop-noble.qcow2
# VM scheduler quotas (per-tenant + global caps; over-quota creates fail loudly)
# EVEX_MAX_VMS_PER_TENANT=4
# EVEX_MAX_TOTAL_VMS=32
# EVEX_MAX_CPU_PER_TENANT=16
# EVEX_MAX_MEM_MB_PER_TENANT=32768
# EVEX_MAX_SESSIONS=64
# Production gate: comma list of postgres,redis,object — startup refuses when unmet
# EVEX_REQUIRE_SERVICES=postgres,redis,object
# EVEX_PUBLIC_URL=https://evex.example.com
# EVEX_CORS_ORIGINS=https://console.example.com
